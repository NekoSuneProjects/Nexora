server {
 listen 80;
 server_name _;
 root /usr/share/nginx/html;
 index index.html;
 add_header X-Content-Type-Options nosniff always;
 add_header Referrer-Policy no-referrer always;
 add_header Cache-Control no-store always;
 add_header X-Frame-Options DENY always;
 add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self' ws: wss:; img-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" always;
 location = / { try_files /home.html =404; }
 location = /app { try_files /index.html =404; }
 location ~ "^/app/channels/[a-fA-F0-9-]{36}/[a-fA-F0-9-]{36}$" { try_files /index.html =404; }
 location ~ ^/(app\.js|crypto\.mjs|private-key-vault\.mjs|e2ee\.mjs|app\.css|home\.css|favicon\.svg)$ {
   # Module scripts require a JavaScript MIME type; set it explicitly for .mjs.
   types { application/javascript js mjs; text/css css; image/svg+xml svg; }
   try_files $uri =404;
 }
 location /api/ {
   proxy_pass ${API_UPSTREAM};
   proxy_set_header Host $http_host;
   proxy_set_header X-Real-IP $remote_addr;
   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
   proxy_set_header X-Forwarded-Proto $scheme;
   proxy_http_version 1.1;
   proxy_set_header Upgrade $http_upgrade;
   proxy_set_header Connection "upgrade";
   proxy_read_timeout 3600s;
 }
 location = /gateway {
   proxy_pass ${API_UPSTREAM};
   proxy_set_header Host $http_host;
   proxy_set_header Upgrade $http_upgrade;
   proxy_set_header Connection "upgrade";
   proxy_http_version 1.1;
   proxy_read_timeout 3600s;
 }
 location / { return 404; }
}
